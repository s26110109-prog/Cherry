                                <div class="stat-bar-fill h-full bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full shadow-[0_0_8px_rgba(0,243,255,0.8)]" style="width: 85%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quest Grid Section Title -->
        <div class="w-full flex items-center justify-between mb-4 border-b border-purple-800/50 pb-2">
            <div class="flex items-center gap-2">
