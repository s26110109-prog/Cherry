            <!-- STAGE 02: Unlocked (Week 2) -->
            <a href="w2/index.html" class="quest-card unlocked shine-effect group relative bg-slate-900/90 border-2 border-pink-500 rounded-xl p-4 flex flex-col justify-between cyber-tile transition-all duration-300 cursor-pointer hover:border-pink-400 shadow-[0_0_15px_rgba(255,0,85,0.2)]">
                <!-- Stage Header -->
                <div class="flex justify-between items-start mb-3">
                    <span class="cyber-badge bg-pink-500 text-white font-black text-xs px-2.5 py-0.5 uppercase tracking-wider">
                        STAGE 02
                    </span>
                    <span class="inline-flex items-center gap-1 text-[10px] font-extrabold px-2 py-0.5 bg-pink-950/80 text-pink-400 border border-pink-500/50 rounded animate-bounce">
