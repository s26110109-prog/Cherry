                    <p class="text-xs text-gray-400 mt-1 line-clamp-1">動態美食轉盤與互動決策網頁</p>
                </div>
                <!-- Footer Info -->
                <div class="mt-3 pt-2 border-t border-slate-800 flex justify-between items-center text-[11px] text-pink-400">
                    <span><i class="fa-regular fa-folder-open mr-1"></i>w2/index.html</span>
                    <span class="group-hover:translate-x-1 transition-transform">ENTER <i class="fa-solid fa-arrow-right ml-0.5"></i></span>
