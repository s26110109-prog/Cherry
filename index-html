    <!-- Floating Notification Box for Locked Click -->
    <div id="toast-msg" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-900/95 border-2 border-pink-500 text-pink-300 px-6 py-3 rounded-xl shadow-[0_0_20px_rgba(255,0,85,0.5)] flex items-center gap-3 transition-all duration-300 opacity-0 translate-y-10 pointer-events-none z-50">
        <i class="fa-solid fa-lock text-xl text-pink-500 animate-pulse"></i>
        <div>
            <div class="font-bold text-sm text-white" id="toast-title">關卡鎖定中 (STAGE LOCKED)</div>
            <div class="text-xs text-gray-300" id="toast-desc">該任務尚未解鎖，請先完成前置冒險關卡！</div>
        </div>
    </div>

    <script>
        // Data for locked stages (Week 3 ~ Week 16)
        const lockedStages = [
            { week: 3, title: "Week 3 - 響應式切板", boss: "CSS Grid 守衛" },
            { week: 4, title: "Week 4 - JavaScript 魔法", boss: "DOM 操作怪" },
            { week: 5, title: "Week 5 - API 資料召喚", boss: "Fetch 遠古巨龍" },
            { week: 6, title: "Week 6 - 動畫與特效", boss: "Keyframe 影武者" },
            { week: 7, title: "Week 7 - 期中冒險實作", boss: "Midterm Mini Boss" },
            { week: 8, title: "Week 8 - 表驗證神器", boss: "RegEx 密碼獸" },
            { week: 9, title: "Week 9 - 遊戲化互動", boss: "Canvas 精靈" },
            { week: 10, title: "Week 10 - Web Audio 音效", boss: "聲波詠唱者" },
            { week: 11, title: "Week 11 - 非同步陣列", boss: "Async/Await 騎士" },
            { week: 12, title: "Week 12 - 框架修練場", boss: "Component 巨人" },
            { week: 13, title: "Week 13 - 狀態管理庫", boss: "Store 聖導士" },
            { week: 14, title: "Week 14 - 後端契約連結", boss: "REST API 惡魔" },
            { week: 15, title: "Week 15 - 期末作品總複習", boss: "Final Guard" },
            { week: 16, title: "Week 16 - 最終大魔王", boss: "網頁大魔王 (Final Boss)" }
        ];

        // Render Locked Stages
        const container = document.getElementById('locked-quests-container');
        
        lockedStages.forEach((stage) => {
            const cardHTML = `
                <div onclick="triggerLockedEffect(this, 'Stage ${stage.week < 10 ? '0' + stage.week : stage.week}')" 
                     class="quest-card locked group relative bg-slate-950/70 border border-slate-800 rounded-xl p-4 flex flex-col justify-between cyber-tile transition-all duration-300 cursor-not-allowed select-none hover:border-slate-700 opacity-60 hover:opacity-80">
                    <!-- Stage Header -->
                    <div class="flex justify-between items-start mb-3">
                        <span class="cyber-badge bg-slate-800 text-gray-400 font-bold text-xs px-2.5 py-0.5 uppercase tracking-wider">
                            STAGE ${stage.week < 10 ? '0' + stage.week : stage.week}
                        </span>
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 bg-slate-900 text-slate-500 border border-slate-800 rounded">
                            🔒 LOCKED
                        </span>
                    </div>
                    <!-- Title & Desc -->
                    <div class="my-2">
                        <h4 class="text-base font-bold text-gray-400 group-hover:text-gray-300">${stage.title}</h4>
                        <p class="text-xs text-slate-500 mt-1"><i class="fa-solid fa-skull mr-1"></i>Boss: ${stage.boss}</p>
                    </div>
                    <!-- Footer Info -->
                    <div class="mt-3 pt-2 border-t border-slate-900 flex justify-between items-center text-[11px] text-slate-600">
                        <span><i class="fa-solid fa-lock mr-1"></i>未開放</span>
                        <span class="text-slate-500">REQUIRE LV.${stage.week * 5}</span>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', cardHTML);
        });

        // Trigger shake & Toast notification on clicking locked stage
        let toastTimeout;
        function triggerLockedEffect(element, stageName) {
            // Add shake class
            element.classList.remove('shake-animation');
            void element.offsetWidth; // trigger reflow
            element.classList.add('shake-animation');

            // Show Toast Box
            const toast = document.getElementById('toast-msg');
            const toastTitle = document.getElementById('toast-title');
            const toastDesc = document.getElementById('toast-desc');

            toastTitle.innerText = `【${stageName}】關卡尚未解鎖！`;
            toastDesc.innerText = `冒險者，請持續解鎖前面的任務來累積經驗值！`;

            toast.classList.remove('opacity-0', 'translate-y-10');
            toast.classList.add('opacity-100', 'translate-y-0');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'translate-y-10');
            }, 2500);
        }

        /* Canvas Interactive Starfield / Particle Engine */
        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');

        let particles = [];
        const particleCount = 60;

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() {
                this.reset();
            }

            reset() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2 + 0.5;
                this.speedX = (Math.random() - 0.5) * 0.5;
                this.speedY = (Math.random() - 0.5) * 0.5;
                this.color = Math.random() > 0.5 ? '#00f3ff' : '#ff0055';
                this.alpha = Math.random() * 0.6 + 0.2;
            }

            update() {
                this.x += this.speedX;
                this.y += this.speedY;

                if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) {
                    this.reset();
                }
            }

            draw() {
                ctx.save();
                ctx.globalAlpha = this.alpha;
                ctx.fillStyle = this.color;
                ctx.shadowBlur = 8;
                ctx.shadowColor = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        // Initialize Particles
        for (let i = 0; i < particleCount; i++) {
            particles.push(new Particle());
        }

        // Animation Loop
        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }
