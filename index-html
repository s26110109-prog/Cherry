<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web Quest Portfolio | 二次元冒險者作品集</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Orbitron for Sci-Fi typography & Noto Sans TC -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700;900&family=Orbitron:wght@500;700;900&display=swap" rel="stylesheet">
    <!-- FontAwesome icons for extra UI embellishments -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --neon-cyan: #00f3ff;
            --neon-pink: #ff0055;
            --neon-purple: #9d00ff;
            --neon-yellow: #ffe600;
            --bg-dark: #0a0a16;
        }

        body {
            font-family: 'Orbitron', 'Noto Sans TC', sans-serif;
            background-color: var(--bg-dark);
            color: #ffffff;
            overflow-x: hidden;
        }

        /* Dynamic Canvas Particle Background */
        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 0;
            pointer-events: none;
        }

        /* Cyberpunk Sci-Fi Clip-path Shapes */
        .cyber-tile {
            clip-path: polygon(
                0 0, 
                calc(100% - 16px) 0, 
                100% 16px, 
                100% 100%, 
                16px 100%, 
                0 calc(100% - 16px)
            );
        }

        .cyber-badge {
            clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
        }

        /* Glowing Effects */
        .glow-cyan {
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.4);
            border: 1px solid rgba(0, 243, 255, 0.8);
        }

        .glow-pink {
            box-shadow: 0 0 15px rgba(255, 0, 85, 0.4);
            border: 1px solid rgba(255, 0, 85, 0.8);
        }

        .text-glow-cyan {
            text-shadow: 0 0 8px rgba(0, 243, 255, 0.8);
        }

        .text-glow-pink {
            text-shadow: 0 0 8px rgba(255, 0, 85, 0.8);
        }

        /* Hover Shine Effect */
        .shine-effect {
            position: relative;
            overflow: hidden;
        }

        .shine-effect::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -60%;
            width: 20%;
            height: 200%;
            background: rgba(255, 255, 255, 0.3);
            transform: rotate(30deg);
            transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1);
        }

        .shine-effect:hover::after {
            left: 140%;
        }

        /* Card Hover Animations */
        .quest-card {
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .quest-card.unlocked:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 10px 25px -5px rgba(0, 243, 255, 0.5), 0 0 15px rgba(157, 0, 255, 0.5);
        }

        /* Shake Animation for Locked Click */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }

        .shake-animation {
            animation: shake 0.4s ease-in-out;
        }

        /* Scanline Overlay for Anime Sci-fi Look */
        .scanlines {
            background: linear-gradient(
                to bottom,
                rgba(255,255,255,0),
                rgba(255,255,255,0) 50%,
                rgba(0, 0, 0, 0.3) 50%,
                rgba(0, 0, 0, 0.3)
            );
            background-size: 100% 4px;
        }

        /* Animated HP/MP Bars */
        .stat-bar-fill {
            transition: width 1s ease-out;
        }
    </style>
</head>
<body class="min-h-screen relative flex flex-col justify-between items-center scanlines selection:bg-pink-500 selection:text-white pb-12">

    <!-- Dynamic Animated Starfield Background -->
    <canvas id="bg-canvas"></canvas>

    <!-- Main Outer Container -->
    <div class="relative z-10 w-full max-w-6xl px-4 pt-8 pb-4 flex flex-col items-center">
        
        <!-- Header Banner / Title -->
